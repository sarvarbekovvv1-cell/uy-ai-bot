# UyAI Foundation Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Application Settings
APP_NAME=UyAI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Telegram Bot Token (obtained from @BotFather)
BOT_TOKEN=

# Database Configuration (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=uyai_db
DATABASE_USER=uyai_user
DATABASE_PASSWORD=uyai_password

# Optional explicit DATABASE_URL (overrides parts above if provided)
# DATABASE_URL=postgresql+asyncpg://uyai_user:uyai_password@localhost:5432/uyai_db

# Logging
LOG_LEVEL=INFO

# Gemini AI Broker
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_BROKER_ENABLED=false
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_HISTORY_MESSAGES=6
# Telegram Mini App Configuration
MINIAPP_URL=
MINIAPP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
MINIAPP_DEV_AUTH_ENABLED=false

# amoCRM Integration Configuration
AMOCRM_ENABLED=false
AMOCRM_BASE_URL=
AMOCRM_SUBDOMAIN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=
AMOCRM_PIPELINE_ID=
AMOCRM_DEFAULT_RESPONSIBLE_USER_ID=
AMOCRM_REQUEST_TIMEOUT_SECONDS=10.0
AMOCRM_MAX_RETRIES=5
AMOCRM_WEBHOOK_SECRET=
# Mapping from internal Lead stage (new, contacted, qualified, viewing_scheduled, negotiation, won, lost) to amoCRM status_id
# Note: amoCRM default system status 142 is Won, 143 is Lost. Intermediate status IDs are pipeline-specific.
# Example: AMOCRM_STAGE_MAPPING_JSON={"new": 101, "contacted": 102, "qualified": 103, "viewing_scheduled": 104, "negotiation": 105, "won": 142, "lost": 143}
AMOCRM_STAGE_MAPPING_JSON=
# Example: AMOCRM_BROKER_MAPPING_JSON={"1": 987654}
AMOCRM_BROKER_MAPPING_JSON=

# Admin / Manager Panel Configuration
ADMIN_URL=http://localhost:5174
ADMIN_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
ADMIN_SESSION_MAX_AGE_SECONDS=28800
ADMIN_SESSION_COOKIE_NAME=uyai_admin_session
ADMIN_SESSION_COOKIE_SECURE=false
ADMIN_SESSION_SECRET=
